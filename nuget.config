<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-level package sources. This replaces the machine-level list, so a restore
  needs only public packages and does not depend on a proxy or on saved
  credentials for internal feeds.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- Local builds of Microsoft.Maui.DevFlow.Agent and Microsoft.Maui.Labs.HotReload in
       ../LocalNuGets are optional. src/BaristaNotes/BaristaNotes.csproj adds that folder as
       a restore source only when it exists, so restore works on machines without it. -->
</configuration>