+#if BENCHMARK_DEVFLOW
+    [Microsoft.Maui.DevFlow.Agent.Core.DevFlowAction("benchmark-command",
+        Description = "Prepare, drive, or inspect the isolated performance probe")]
+    public static string DevFlowCommand(string command, string route = "", int sample = 0)
+    {
+        var activity = PerformanceCurrent;
+        if (activity is null)
+            return "state=missing;failure=activity-not-running";
+        if (command == "prepare")
+        {
+            if (activity._performanceState != "ready")
+                return activity.Status("probe-not-ready");
+            activity._performanceRoute = route;
+            activity._performanceSample = sample;
+            return activity.Status(null);
+        }
+        return activity.ReceivePerformanceCommand(command);
+    }
+#endif
 
