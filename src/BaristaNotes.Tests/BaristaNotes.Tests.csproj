<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Avoid MAUI specific target frameworks for test project -->
    <UseMauiEssentials>false</UseMauiEssentials>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0-rc.1.26425.128" />
    <PackageReference Include="Microsoft.Maui.Core" Version="11.0.0-rc.1.26451.6" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Microsoft.Maui.Graphics" />
    <Compile Include="..\BaristaNotes\Resources\Styles\AppColors.cs" Link="Styles\AppColors.cs" />
    <Compile Include="..\BaristaNotes\Components\BeanPageScrollGeometry.cs"
             Link="Components\BeanPageScrollGeometry.cs" />
    <Compile Include="..\BaristaNotes.Android\Views\UiAnimationLifetime.cs"
             Link="Native\UiAnimationLifetime.cs" />
    <Compile Include="..\BaristaNotes.iOS\SpeechPermissionPreflight.cs"
             Link="Native\SpeechPermissionPreflight.cs" />
    <None Include="..\BaristaNotes\Platforms\Android\Resources\**\*.xml"
          Link="AndroidResources\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Reorder agent: the app's pure sharing, seeding, and wording logic. -->
  <ItemGroup>
    <Compile Include="..\BaristaNotes\Services\Agent\AgentSnapshotMapper.cs" Link="Agent\AgentSnapshotMapper.cs" />
    <Compile Include="..\BaristaNotes\Services\Agent\DemoSeedPlan.cs" Link="Agent\DemoSeedPlan.cs" />
    <Compile Include="..\BaristaNotes\Services\Agent\AgentText.cs" Link="Agent\AgentText.cs" />
    <Compile Include="..\BaristaNotes\Services\Agent\AgentHomeCard.cs" Link="Agent\AgentHomeCard.cs" />
    <None Include="..\BaristaNotes\Resources\Raw\demo\demo-data.json" Link="Agent\demo-data.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BaristaNotes.Core\BaristaNotes.Core.csproj" />
    <ProjectReference Include="..\BaristaNotes.Agent.Contracts\BaristaNotes.Agent.Contracts.csproj" />
  </ItemGroup>

</Project>