diff --git a/src/BenchmarkDevFlowBrokerRejector.cs b/src/BenchmarkDevFlowBrokerRejector.cs
new file mode 100644
--- /dev/null
+++ b/src/BenchmarkDevFlowBrokerRejector.cs
@@ -0,0 +1,28 @@
+using System.Net;
+using System.Net.Sockets;
+
+namespace BaristaNotes.Benchmarking;
+
+internal static class BenchmarkDevFlowBrokerRejector
+{
+    public static void Start()
+    {
+        StartListener(IPAddress.Loopback);
+        StartListener(IPAddress.IPv6Loopback);
+    }
+
+    private static void StartListener(IPAddress address)
+    {
+        var listener = new TcpListener(address, 19223);
+        listener.Start();
+        var thread = new Thread(() =>
+        {
+            while (true)
+            {
+                using var connection = listener.AcceptTcpClient();
+            }
+        });
+        thread.IsBackground = true;
+        thread.Start();
+    }
+}
