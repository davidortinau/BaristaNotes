diff --git a/Directory.Build.props b/Directory.Build.props
new file mode 100644
--- /dev/null
+++ b/Directory.Build.props
@@ -0,0 +1,8 @@
+<Project>
+  <PropertyGroup>
+    <MauiVersion>11.0.0</MauiVersion>
+    <BaseIntermediateOutputPath>$(BenchmarkOutputRoot)/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
+    <BaseOutputPath>$(BenchmarkOutputRoot)/bin/$(MSBuildProjectName)/</BaseOutputPath>
+    <RestoreLockedMode>false</RestoreLockedMode>
+  </PropertyGroup>
+</Project>
diff --git a/Directory.Build.targets b/Directory.Build.targets
new file mode 100644
--- /dev/null
+++ b/Directory.Build.targets
@@ -0,0 +1,8 @@
+<Project>
+  <ItemGroup>
+    <PackageReference Update="Microsoft.EntityFrameworkCore;Microsoft.EntityFrameworkCore.Design;Microsoft.EntityFrameworkCore.Sqlite;Microsoft.EntityFrameworkCore.Tasks;Microsoft.Extensions.Configuration.Json;Microsoft.Extensions.Http;Microsoft.Extensions.Logging;Microsoft.Extensions.Logging.Debug;Microsoft.Maui.Graphics" Version="11.0.0" />
+  </ItemGroup>
+  <Target Name="RecordBenchmarkConfiguration" BeforeTargets="PrepareForBuild">
+    <Message Importance="High" Text="BENCHMARK project=$(MSBuildProjectName) sdk=$(NETCoreSdkVersion) tfm=$(TargetFramework) rid=$(RuntimeIdentifier) app=$(ApplicationId) maui=$(MauiVersion) mono=$(UseMonoRuntime) aot=$(PublishAot) r2r=$(PublishReadyToRun) composite=$(PublishReadyToRunComposite) full=$(MauiEnableFullReadyToRun) crossgen2=$(PublishReadyToRunCrossgen2ExtraArgs)" />
+  </Target>
+</Project>
