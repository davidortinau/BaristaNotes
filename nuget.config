<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-level package sources. This replaces the machine-level list, so a restore
  needs only public packages and does not depend on a proxy or on saved
  credentials for internal feeds.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>